<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBF8FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TOP BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/profile_circle"
                android:gravity="center"
                android:includeFontPadding="false"
                android:padding="0dp"
                android:text="←"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Exam Prep 🎯"
                android:textColor="#292536"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- EXAM STATUS -->
        <TextView
            android:id="@+id/tvExamStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/action_card_purple"
            android:padding="16dp"
            android:text="📋 Exam Status&#10;&#10;Ready for analysis"
            android:textColor="#292536"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- PRIORITY TOPICS -->
        <TextView
            android:id="@+id/tvPriorityTopics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/action_card_yellow"
            android:padding="16dp"
            android:text="⭐ Priority Topics&#10;&#10;Your important topics will appear here."
            android:textColor="#292536"
            android:textSize="14sp" />

        <!-- REVISION PLAN -->
        <TextView
            android:id="@+id/tvRevisionPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/action_card_blue"
            android:padding="16dp"
            android:text="📚 Revision Plan&#10;&#10;Your revision plan will appear here."
            android:textColor="#292536"
            android:textSize="14sp" />

        <!-- MOCK TEST -->
        <TextView
            android:id="@+id/tvMockTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/action_card_green"
            android:padding="16dp"
            android:text="📝 Mock Test&#10;&#10;Mock test recommendations will appear here."
            android:textColor="#292536"
            android:textSize="14sp" />

        <!-- OVERALL -->
        <TextView
            android:id="@+id/tvOverall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/action_card_lavender"
            android:padding="16dp"
            android:text="🎯 Overall Preparation&#10;&#10;Click Analyze to check your preparation."
            android:textColor="#292536"
            android:textSize="14sp" />

        <!-- ANALYZE BUTTON -->
        <Button
            android:id="@+id/btnAnalyze"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/primary_button"
            android:gravity="center"
            android:padding="0dp"
            android:text="Analyze My Preparation ✨"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
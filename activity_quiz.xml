<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBF8FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Back Button -->

        <Button
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/profile_circle"
            android:gravity="center"
            android:padding="0dp"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Title -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quiz Time 🧠"
            android:textColor="#292536"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:text="Choose a subject and test your knowledge!"
            android:textColor="#777181"
            android:textSize="15sp" />

        <!-- Subject Selection -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Subject"
            android:textColor="#292536"
            android:textSize="16sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp">

            <Spinner
                android:id="@+id/spinnerSubject"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/secondary_button"
                android:paddingStart="12dp"
                android:paddingEnd="45dp"
                android:spinnerMode="dropdown" />

            <TextView
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:gravity="center"
                android:text="▼"
                android:textColor="#6C4AB6"
                android:textSize="16sp"
                android:clickable="false"
                android:focusable="false" />

        </FrameLayout>        <!-- Question Card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/action_card_purple"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvQuestionNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Question 1 of 5"
                android:textColor="#6C4AB6"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Question"
                android:textColor="#292536"
                android:textSize="19sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Options -->

        <RadioGroup
            android:id="@+id/radioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbOption1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#6C4AB6"
                android:padding="12dp"
                android:text="Option 1"
                android:textColor="#292536"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbOption2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#6C4AB6"
                android:padding="12dp"
                android:text="Option 2"
                android:textColor="#292536"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbOption3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#6C4AB6"
                android:padding="12dp"
                android:text="Option 3"
                android:textColor="#292536"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbOption4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#6C4AB6"
                android:padding="12dp"
                android:text="Option 4"
                android:textColor="#292536"
                android:textSize="16sp" />

        </RadioGroup>

        <!-- Next Button -->

        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/primary_button"
            android:text="Next Question"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Result -->

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/action_card_green"
            android:gravity="center"
            android:padding="24dp"
            android:text="Your Score"
            android:textColor="#292536"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
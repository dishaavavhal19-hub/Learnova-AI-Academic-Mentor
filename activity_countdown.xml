<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9EF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TOP BAR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:background="@drawable/primary_button"
                android:contentDescription="Back"
                android:gravity="center"
                android:padding="0dp"
                android:text="←"
                android:textAllCaps="false"
                android:textColor="@color/purple_light"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Exam Countdown ⏳"
                android:textColor="#292536"
                android:textSize="21sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="52dp"
                android:layout_height="1dp" />

        </LinearLayout>

        <!-- DESCRIPTION -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Keep track of how much time is left for your exam."
            android:textColor="#777181"
            android:textSize="14sp" />

        <!-- INPUT CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/primary_button"
            android:orientation="vertical"
            android:padding="18dp">

            <EditText
                android:id="@+id/etExamSubject"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="#FBF8FF"
                android:hint="Exam subject"
                android:padding="15dp"
                android:textColor="#292536"
                android:textColorHint="#9993A2"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etExamDate"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="12dp"
                android:background="#FBF8FF"
                android:hint="Exam date (dd/MM/yyyy)"
                android:inputType="text"
                android:padding="15dp"
                android:textColor="#292536"
                android:textColorHint="#9993A2"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnSaveExam"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:background="#6C4AB6"
                android:gravity="center"
                android:padding="0dp"
                android:text="Save Exam 📅"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- COUNTDOWN TITLE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="Your Next Exam"
            android:textColor="#292536"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvExamSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="No exam selected"
            android:textColor="#6C4AB6"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- COUNTDOWN CARDS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="115dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="#F0E9FF"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#6C4AB6"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DAYS"
                    android:textColor="#777181"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="115dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="#EAF4FF"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#4C7DB6"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HOURS"
                    android:textColor="#777181"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="115dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="#EAF9F1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMinutes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#45916A"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MINUTES"
                    android:textColor="#777181"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="115dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="#FFF0F4"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSeconds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#B35C76"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SECONDS"
                    android:textColor="#777181"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- MOTIVATION -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#EEE7FF"
            android:gravity="center"
            android:padding="18dp"
            android:text="✨ Every second counts. Keep studying!"
            android:textColor="#6C4AB6"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>